# PostgreSQL Database Connection URL
DATABASE_URL=postgres://postgres:password123@localhost:5432/shoes_db

# Secret key for Admin JWT Authentication
JWT_SECRET=your_jwt_secret_key_here

# Rust Actix-web server port
PORT=8080

# Logging level
RUST_LOG=info

# Production CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:4321,http://localhost:5173,https://yourdomain.com
