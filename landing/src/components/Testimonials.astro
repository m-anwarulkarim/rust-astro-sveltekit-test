---
const reviews = [
  {
    name: "Dr. Alim Rahman",
    role: "Managing Director, Apex Capital",
    comment: "The Monarch Imperial Oxford is hands down the finest Goodyear-welted shoe in my collection. The hand-burnished mahogany finish turns heads in every boardroom.",
    rating: 5,
    avatar: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=200&auto=format&fit=crop",
    verified: "Verified Buyer"
  },
  {
    name: "Zariyan Chowdhury",
    role: "Creative Director & Stylist",
    comment: "Aurelia Royal Gold sneakers bridge the gap between street luxury and haute couture. The Italian calfskin is insanely supple right out of the box.",
    rating: 5,
    avatar: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?q=80&w=200&auto=format&fit=crop",
    verified: "VIP Member"
  },
  {
    name: "Saadman Sakib",
    role: "Entrepreneur & Connoisseur",
    comment: "The Cash on Delivery concierge service in Dhaka was seamless. Received my Sovereign Velvet Loafers within 24 hours in a handcrafted presentation box.",
    rating: 5,
    avatar: "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?q=80&w=200&auto=format&fit=crop",
    verified: "Verified Buyer"
  },
  {
    name: "Tariqul Islam",
    role: "Senior Partner, Lex Law Firm",
    comment: "Flawless craftsmanship and remarkable ergonomic arch support. Aurelia has brought true Italian luxury cordwaining to Bangladesh.",
    rating: 5,
    avatar: "https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?q=80&w=200&auto=format&fit=crop",
    verified: "Verified Buyer"
  },
  {
    name: "Nafis Fuad",
    role: "Founder, Imperial Lifestyle",
    comment: "Exquisite attention to stitching details. The 24K electroplated gold accents on the Aurelia sneakers are pure elegance.",
    rating: 5,
    avatar: "https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?q=80&w=200&auto=format&fit=crop",
    verified: "VIP Member"
  }
];
---

<section id="reviews" class="py-24 bg-[#FAF7F2] border-t border-[var(--border-color)] overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 space-y-12">
    
    <!-- Section Header & Controls -->
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="space-y-4 max-w-2xl text-left">
        <span class="text-xs uppercase tracking-[0.25em] font-bold text-[var(--accent-gold)] block">
          Client Testimonials
        </span>
        <h2 class="font-serif text-4xl sm:text-5xl font-extrabold text-slate-900">
          Worn by Industry Leaders & Connoisseurs
        </h2>
        <p class="text-slate-600 text-sm sm:text-base font-light">
          Hear from our discerning patrons who experience the unrivaled comfort and prestige of Aurelia footwear.
        </p>
      </div>

      <!-- Slider Controls -->
      <div class="flex items-center gap-3">
        <button 
          id="prev-testimonial-btn"
          class="w-12 h-12 rounded-full border border-slate-300 bg-white text-slate-800 hover:border-[var(--accent-gold)] hover:bg-[var(--accent-gold)] hover:text-slate-950 transition-all flex items-center justify-center shadow-sm"
          aria-label="Previous Testimonials"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <button 
          id="next-testimonial-btn"
          class="w-12 h-12 rounded-full border border-slate-300 bg-white text-slate-800 hover:border-[var(--accent-gold)] hover:bg-[var(--accent-gold)] hover:text-slate-950 transition-all flex items-center justify-center shadow-sm"
          aria-label="Next Testimonials"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Single Line Horizontal Carousel Slider Container -->
    <div 
      id="testimonial-slider-container" 
      class="flex gap-6 overflow-x-auto scroll-smooth snap-x snap-mandatory py-4 no-scrollbar"
      style="scrollbar-width: none; -ms-overflow-style: none;"
    >
      {reviews.map(item => (
        <div class="w-[320px] sm:w-[380px] flex-shrink-0 snap-align-start glass-card rounded-3xl p-7 space-y-6 flex flex-col justify-between relative group">
          <div class="space-y-4">
            <!-- Rating Stars (SVG Icons) -->
            <div class="flex items-center gap-1">
              {Array.from({ length: item.rating }).map(() => (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-400 fill-amber-400" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            
            <p class="text-xs sm:text-sm text-slate-700 font-light italic leading-relaxed">
              "{item.comment}"
            </p>
          </div>

          <!-- Reviewer Info -->
          <div class="flex items-center gap-4 pt-4 border-t border-slate-100">
            <img 
              src={item.avatar} 
              alt={item.name} 
              class="w-12 h-12 rounded-full object-cover border-2 border-[var(--border-gold)] shadow-sm flex-shrink-0"
            />
            <div>
              <h4 class="font-serif font-bold text-slate-900 text-sm">{item.name}</h4>
              <span class="text-[11px] text-slate-500 block leading-tight">{item.role}</span>
              <span class="inline-flex items-center gap-1 mt-1 text-[10px] uppercase font-bold text-amber-800 bg-amber-50 px-2 py-0.5 rounded-full border border-amber-200">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
                {item.verified}
              </span>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>


<script is:inline>
  function setupTestimonialSlider() {
    const container = document.getElementById('testimonial-slider-container');
    const prevBtn = document.getElementById('prev-testimonial-btn');
    const nextBtn = document.getElementById('next-testimonial-btn');

    if (!container || !prevBtn || !nextBtn) return;

    const scrollAmount = 380;

    prevBtn.onclick = function() {
      container.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
    };

    nextBtn.onclick = function() {
      container.scrollBy({ left: scrollAmount, behavior: 'smooth' });
    };
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupTestimonialSlider);
  } else {
    setupTestimonialSlider();
  }
</script>
