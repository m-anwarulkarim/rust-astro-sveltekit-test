---
---

<section id="craftsmanship" class="py-24 bg-[#FAF7F2] relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 space-y-16">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Image Grid -->
      <div class="lg:col-span-6 grid grid-cols-2 gap-4 relative">
        <div class="space-y-4">
          <img 
            src="https://images.unsplash.com/photo-1595950653106-6c9ebd614d3a?q=80&w=800&auto=format&fit=crop" 
            alt="Handstitched Leather Crafting"
            class="rounded-2xl shadow-lg w-full h-64 object-cover border border-[var(--border-color)]"
          />
          <div class="bg-white p-6 rounded-2xl border border-[var(--border-color)] shadow-md">
            <h4 class="font-serif text-xl font-bold text-slate-900 mb-1">Goodyear Welted</h4>
            <p class="text-xs text-slate-500 font-light">Engineered to be resoled indefinitely for a lifetime of elegance.</p>
          </div>
        </div>

        <div class="space-y-4 pt-8">
          <div class="bg-gradient-to-br from-[#D4AF37] to-[#C5A880] text-slate-950 p-6 rounded-2xl shadow-lg">
            <span class="font-serif text-3xl font-bold block mb-1">72 Hours</span>
            <p class="text-xs font-semibold uppercase tracking-wider">Dedicated Handcrafting Per Pair</p>
          </div>
          <img 
            src="https://images.unsplash.com/photo-1543163521-1bf539c55dd2?q=80&w=800&auto=format&fit=crop" 
            alt="Patina Finishing"
            class="rounded-2xl shadow-lg w-full h-64 object-cover border border-[var(--border-color)]"
          />
        </div>
      </div>

      <!-- Narrative Text -->
      <div class="lg:col-span-6 space-y-6">
        <span class="text-xs uppercase tracking-[0.25em] font-bold text-[var(--accent-gold)] block">
          Unrivaled Artistry
        </span>
        <h2 class="font-serif text-4xl sm:text-5xl font-extrabold text-slate-900 leading-tight">
          Handcrafted in Florence, Worn by Distinction
        </h2>
        <p class="text-slate-600 font-light leading-relaxed">
          Every pair of Aurelia footwear undergoes over 200 individual manual steps. From hand-selecting full-grain Tuscan calfskins to applying layers of natural oils and waxes for our signature burnished patina.
        </p>

        <div class="space-y-4 pt-4">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-amber-100 flex items-center justify-center text-[var(--accent-gold)] flex-shrink-0 font-bold">✓</div>
            <div>
              <h4 class="font-serif font-bold text-slate-900">Aniline-Dyed Calfskin</h4>
              <p class="text-xs text-slate-500">Naturally breathable leather that conforms to your foot contours over time.</p>
            </div>
          </div>
          
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-amber-100 flex items-center justify-center text-[var(--accent-gold)] flex-shrink-0 font-bold">✓</div>
            <div>
              <h4 class="font-serif font-bold text-slate-900">Micro-Cellular Foam Insole</h4>
              <p class="text-xs text-slate-500">Absorbs shock while maintaining lightweight agility for all-day comfort.</p>
            </div>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>
