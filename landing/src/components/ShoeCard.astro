---
interface Props {
  id?: string;
  title: string;
  subtitle?: string;
  description: string;
  price: number;
  original_price?: number;
  category: string;
  image_url: string;
  badge?: string;
  sizes?: number[];
  colors?: string[];
  stock?: number;
}

const {
  id = "1",
  title,
  subtitle,
  description,
  price,
  original_price,
  category,
  image_url,
  badge = "Popular",
  sizes = [39, 40, 41, 42, 43, 44],
  colors = ["Champagne Gold", "Obsidian Onyx", "Ivory White"],
  stock = 30
} = Astro.props;
---

<div class="glass-card rounded-2xl overflow-hidden flex flex-col justify-between group" data-category={category}>
  <!-- Card Header Image Container -->
  <div class="relative w-full h-72 overflow-hidden bg-slate-100 flex items-center justify-center">
    {badge && (
      <span class="absolute top-4 left-4 bg-white/90 backdrop-blur-md border border-[var(--border-gold)] text-slate-900 font-semibold text-xs px-3 py-1 rounded-full z-10 shadow-sm">
        {badge}
      </span>
    )}
    
    <span class="absolute top-4 right-4 bg-slate-900/80 text-amber-300 font-medium text-[11px] px-2.5 py-0.5 rounded-full z-10">
      {stock > 0 ? `${stock} Pairs Left` : 'Pre-order Only'}
    </span>

    <img 
      src={image_url} 
      alt={title}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      loading="lazy"
    />
  </div>

  <!-- Card Body -->
  <div class="p-6 space-y-4 flex-1 flex flex-col justify-between">
    <div>
      <div class="flex items-center justify-between text-xs text-slate-500 uppercase tracking-widest font-semibold mb-1">
        <span>{category}</span>
        <span class="text-amber-600 font-bold">EU {sizes.join(', ')}</span>
      </div>

      <h3 class="font-serif text-xl font-bold text-slate-900 group-hover:text-[var(--accent-gold)] transition-colors">
        {title}
      </h3>
      
      {subtitle && (
        <p class="text-xs text-[var(--accent-rose)] font-medium mt-0.5">{subtitle}</p>
      )}

      <p class="text-xs text-slate-600 font-light line-clamp-2 mt-2 leading-relaxed">
        {description}
      </p>
    </div>

    <!-- Pricing & Action Row -->
    <div class="pt-4 border-t border-slate-100 space-y-3">
      <div class="flex items-baseline gap-3">
        <span class="font-serif text-2xl font-bold text-slate-900">৳ {Math.round(price).toLocaleString()}</span>
        {original_price && (
          <span class="text-sm text-slate-400 line-through">৳ {Math.round(original_price).toLocaleString()}</span>
        )}
      </div>

      <button
        onclick={`window.openOrderModal('${title.replace(/'/g, "\\'")}', ${price}, '${image_url}', '${description.replace(/'/g, "\\'")}')`}
        class="w-full btn-gold text-xs py-3 justify-center shadow-md uppercase tracking-wider cursor-pointer"
      >
        <span>Order Now</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
      </button>
    </div>
  </div>
</div>
