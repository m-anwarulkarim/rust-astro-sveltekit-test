---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "AURELIA | Luxury Footwear & Artisanal Leather Craftsmanship",
  description = "Discover Aurelia's royal footwear collection. Handcrafted Italian calfskin, champagne gold finishes, and ergonomic comfort."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body class="bg-ivory text-royal-slate font-sans min-h-screen flex flex-col antialiased selection:bg-gold/20 selection:text-royal-slate">
    <slot />
  </body>
</html>
